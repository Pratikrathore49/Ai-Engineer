# --- LLM / embeddings (OpenAI-compatible) ---
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600

# --- Vector store ---
CHROMA_PATH=./data/chroma
COLLECTION_NAME=company_docs
DATA_DIR=./data/docs

# --- Retrieval ---
TOP_K=5
RETRIEVE_CANDIDATES=20        # broad first-stage fetch before rerank
BM25_WEIGHT=0.5               # 0..1 balance between lexical and semantic
MIN_RELEVANCE_SCORE=0.35       # below this -> circuit-breaker "no info"
RERANK_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# --- App ---
API_KEY=change-me-in-prod
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MIN=60
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO